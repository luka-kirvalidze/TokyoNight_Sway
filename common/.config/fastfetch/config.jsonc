{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "position": "top",
    "source": "~/dotfiles/common/.config/fastfetch/ascii/fedora.txt"
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#34}╭────────────────────╮"
    },
    {
      "type": "title",
      "key": "{#34}│ {#31}󰋋  user            {#34}│",
      "format": "{#31}{user-name}"
    },
    {
      "type": "title",
      "key": "{#34}│ {#33}󰍹  hname           {#34}│",
      "format": "{#33}{host-name}"
    },
    {
      "type": "os",
      "key": "{#34}│ {#32}  distro          {#34}│",
      "format": "{#32}{name}"
    },
    {
      "type": "kernel",
      "key": "{#34}│ {#36}  kernel          {#34}│",
      "format": "{#36}{release}"
    },
    {
      "type": "uptime",
      "key": "{#34}│ {#35}󰅐  uptime          {#34}│",
      "format": "{#34}{formatted}"
    },
    {
      "type": "shell",
      "key": "{#34}│ {#31}󰞷  shell           {#34}│",
      "format": "{#35}{exe-name}"
    },
    {
      "type": "packages",
      "key": "{#34}│ {#33}󰏗  pkgs            {#34}│",
      "format": "{#31}{all}"
    },
    {
      "type": "memory",
      "key": "{#34}│ {#32}󰍛  memory          {#34}│",
      "format": "{#33}{used} | {total}"
    },
    {
      "type": "custom",
      "format": "{#34}├────────────────────┤"
    },
    {
      "type": "colors",
      "key": "{#34}│ {#35}󰏘  colors          {#34}│",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "{#34}╰────────────────────╯"
    }
  ]
}
